// Prisma schema for the EU Withdrawal app (MySQL 8).
// Every shop-owned model carries `shopId` and is only ever queried through
// helpers that scope by the authenticated shop (see app/models/*.server.ts).
// MySQL note: Prisma `String` maps to VARCHAR(191); long text uses @db.Text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Required by @shopify/shopify-app-session-storage-prisma.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Shop {
  id               String    @id @default(cuid())
  shopDomain       String    @unique // {shop}.myshopify.com
  name             String?
  contactEmail     String?
  ianaTimezone     String    @default("UTC")
  currencyCode     String?
  installedAt      DateTime  @default(now())
  uninstalledAt    DateTime?
  // Monotonic counter used to issue human-readable request numbers per shop.
  requestCounter   Int       @default(0)
  // Set the first time the storefront form is served through the app proxy.
  proxyLastSeenAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  settings         ShopSettings?
  forms            Form[]
  requests         WithdrawalRequest[]
  emailTemplates   EmailTemplate[]
  emailLogs        EmailLog[]
  notes            InternalNote[]
  statusHistory    RequestStatusHistory[]
  dataRequests     PrivacyDataRequest[]
}

model ShopSettings {
  id                       String   @id @default(cuid())
  shopId                   String   @unique
  shop                     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Empty = use Shop.ianaTimezone from Shopify.
  timezoneOverride         String?
  defaultLocale            String   @default("en")
  defaultFormId            String?
  buttonLabel              String   @default("Withdraw from contract")
  buttonHelpText           String?  @db.Text
  buttonBgColor            String   @default("#1a1a1a")
  buttonTextColor          String   @default("#ffffff")
  merchantNotificationEmails String? @db.Text // comma separated
  replyToEmail             String?
  sendStatusChangeEmails   Boolean  @default(false)
  // Informational only; merchants decide what is legally appropriate.
  withdrawalPeriodDays     Int      @default(14)
  withdrawalPeriodNote     String?  @db.Text
  orderLookupEnabled       Boolean  @default(false)
  orderTaggingEnabled      Boolean  @default(false)
  orderTag                 String   @default("withdrawal-requested")
  rateLimitPerHour         Int      @default(5)
  minFillSeconds           Int      @default(3)
  // 0 = never auto-delete. Applies to archived requests only.
  retentionDays            Int      @default(0)
  // Merchant-confirmed checklist items (the app cannot read theme state).
  setupBlockConfirmed      Boolean  @default(false)
  setupLegalReviewed       Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Form {
  id                 String        @id @default(cuid())
  shopId             String
  shop               Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  // Working copy edited in the builder; validated against FormSchema (zod).
  draftSchema        Json
  draftUpdatedAt     DateTime      @default(now())
  // Currently live version. Null = unpublished.
  publishedVersionId String?       @unique
  publishedVersion   FormVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           FormVersion[] @relation("FormVersions")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([shopId])
}

// Immutable snapshot created on every publish. Requests reference the exact
// version they were submitted against, so later edits never alter history.
model FormVersion {
  id          String              @id @default(cuid())
  shopId      String
  formId      String
  form        Form                @relation("FormVersions", fields: [formId], references: [id], onDelete: Cascade)
  version     Int
  schema      Json
  createdAt   DateTime            @default(now())
  publishedOf Form?               @relation("PublishedVersion")
  requests    WithdrawalRequest[]

  @@unique([formId, version])
  @@index([shopId])
}

enum RequestStatus {
  REQUESTED
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum OrderVerification {
  VERIFIED
  UNVERIFIED
  NOT_FOUND
}

model WithdrawalRequest {
  id                 String            @id @default(cuid())
  shopId             String
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requestNumber      String
  formVersionId      String?
  formVersion        FormVersion?      @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  status             RequestStatus     @default(REQUESTED)
  customerName       String?
  customerEmail      String
  // Lower-cased copy for case-insensitive search and privacy lookups.
  customerEmailNorm  String
  orderReference     String?
  orderVerification  OrderVerification @default(UNVERIFIED)
  shopifyOrderId     String?           // gid, only when verified
  shopifyCustomerId  String?           // from app proxy logged_in_customer_id
  orderProcessedAt   DateTime?         // informational, for period hints
  locale             String?
  // Client-supplied nonce from the review step; enforces exactly-once submit.
  idempotencyKey     String
  submittedAt        DateTime          @default(now())
  archivedAt         DateTime?
  orderTaggedAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  answers            WithdrawalAnswer[]
  statusHistory      RequestStatusHistory[]
  notes              InternalNote[]
  emailLogs          EmailLog[]

  @@unique([shopId, requestNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, status, archivedAt])
  @@index([shopId, submittedAt])
  @@index([shopId, customerEmailNorm])
  @@index([shopId, orderReference])
}

// One row per submitted field. Label/type are snapshotted at submit time.
model WithdrawalAnswer {
  id          String            @id @default(cuid())
  shopId      String
  requestId   String
  request     WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fieldId     String
  fieldType   String
  label       String            @db.Text
  // JSON-encoded string or string[]
  value       Json
  adminOnly   Boolean           @default(false)
  position    Int

  @@unique([requestId, fieldId])
  @@index([shopId])
}

model RequestStatusHistory {
  id          String            @id @default(cuid())
  shopId      String
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requestId   String
  request     WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // e.g. STATUS_CHANGE, ARCHIVED, RESTORED, CREATED
  event       String
  fromStatus  RequestStatus?
  toStatus    RequestStatus?
  actor       String            // "customer", "system" or "staff:<id>"
  createdAt   DateTime          @default(now())

  @@index([shopId, requestId])
}

model InternalNote {
  id          String            @id @default(cuid())
  shopId      String
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requestId   String
  request     WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  body        String            @db.Text
  author      String
  createdAt   DateTime          @default(now())

  @@index([shopId, requestId])
}

enum EmailTemplateKind {
  CUSTOMER_CONFIRMATION
  MERCHANT_NOTIFICATION
  STATUS_CHANGE
}

model EmailTemplate {
  id        String            @id @default(cuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind      EmailTemplateKind
  subject   String            @db.Text
  body      String            @db.Text
  enabled   Boolean           @default(true)
  updatedAt DateTime          @updatedAt

  @@unique([shopId, kind])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DEAD
}

// Outbox: rows are created in the same transaction as the request, then
// delivered by the email worker. `dedupeKey` prevents duplicate sends.
model EmailLog {
  id            String             @id @default(cuid())
  shopId        String
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requestId     String?
  request       WithdrawalRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind          String
  dedupeKey     String
  toAddress     String             @db.Text
  replyTo       String?
  subject       String             @db.Text
  bodyText      String             @db.Text
  bodyHtml      String             @db.Text
  status        EmailStatus        @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?            @db.Text
  providerId    String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([shopId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([shopId, requestId])
}

// Abuse prevention. `keyHash` is an HMAC of shop + client IP; raw IPs are
// never stored. Rows older than 24h are purged by the maintenance job.
model RateLimitHit {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

// Webhook idempotency: Shopify may deliver the same webhook more than once.
model ProcessedWebhook {
  webhookId   String   @id
  shopDomain  String
  topic       String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// Record of customers/data_request webhooks so the merchant can fulfil them.
model PrivacyDataRequest {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerEmail String?
  shopifyCustomerId String?
  requestCount  Int
  payload       Json     // the exported data prepared for the merchant
  createdAt     DateTime @default(now())

  @@index([shopId])
}
