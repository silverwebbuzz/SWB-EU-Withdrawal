# Copy to .env for local development. Never commit real secrets.

# --- Shopify (populated automatically by `shopify app dev`; set manually in production)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=

# --- Database (MySQL 8). docker-compose.yml exposes MySQL on port 3307.
DATABASE_URL="mysql://swb:swb_dev_password@127.0.0.1:3307/swb_withdrawal"
# Used only by `npm test` (integration tests). Must be a separate database.
TEST_DATABASE_URL="mysql://swb:swb_dev_password@127.0.0.1:3307/swb_withdrawal_test"

# --- Secrets for signing storefront form tokens and hashing IPs for rate limiting.
# Generate with: openssl rand -hex 32
APP_SIGNING_SECRET=

# --- Email delivery. EMAIL_PROVIDER = log | smtp | resend
# "log" writes emails to the server console instead of sending (development only).
EMAIL_PROVIDER=log
EMAIL_FROM="Withdrawals <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- Background jobs (email retries, retention purge). Set to "false" when you
# run `npm run jobs` as a separate process instead.
RUN_JOBS_IN_PROCESS=true
# Bearer token for POST /api/jobs (only needed when RUN_JOBS_IN_PROCESS=false).
JOBS_SECRET=
